// 结构体定义
struct MyStruct {
    int member1;
    char member2;
    int arrayMember[10];
    int *alpha;
    int (*point)[2];
};
// 另一个结构体定义
struct ComplexStruct {
    int a;
    char y;
    struct MyStruct nested;//结构体内的struct缺失解决不了
};
// 全局变量声明
int globalVar;
char globalChar;
int globalArray[5];
struct MyStruct globalStruct;//global的struct缺失解决不了//疑难杂症，这个地方要是缺;我就会似
struct MyStruct2;
int *globalPointer;
char *charPointer;
// 只有类型声明
int;
//定义 结合顺序
int (*point)[2];
// 函数定义
int main (int argc, char *argv[10]){
    // 变量声明
    int localVar;
    char localChar = 'a';
    int localArray[10];
    struct MyStruct localStruct;
    struct ComplexStruct complex;
    int *ptr;
    char *str;
    // 赋值表达式
    localVar = 42;
    localChar = '\n';
    ptr = &localVar;
    // 算术运算
    int result = localVar + 5;
    result = localVar - 3;
    result = localVar * 2;
    result = localVar / 2;
    result = localVar % 3;
    // 自增自减
    localVar++;
    ++localVar;
    localVar--;
    --localVar;
    // 比较运算
    if (localVar < 50) {
        result = 1;
    }
    if (localVar <= 50) {
        result = 2;
    }
    if (localVar > 10) {
        result = 3;
    }
    if (localVar >= 10) {
        result = 4;
    }
    if (localVar == 42) {
        result = 5;
    }
    if (localVar != 0) {
        result = 6;
    }
    // 逻辑运算
    if (localVar > 0 && localVar < 100) {
        result = 7;
    }
    if (localVar < 0 || localVar > 100) {
        result = 8;
    }
    if (!(localVar == 0)) {
        result = 9;
    }
    // 位运算和指针运算
    int value = *ptr;
    ptr = &value;
    int **pptr = &ptr;
    // 数组访问
    localArray[0] = 1;
    localArray[1] = localArray[0] + 1;
    // 结构体成员访问
    localStruct.member1 = 10;
    localStruct.member2 = 'b';
    localStruct.arrayMember[0] = 100;
    // 结构体指针成员访问
    struct MyStruct *structPtr = &localStruct;
    structPtr->member1 = 20;
    structPtr->member2 = 'c';
    // 函数调用
    result = add(5,3);
    localChar = getChar();
    result = add(localVar, result);
    // 复杂表达式
    result = (localVar + 5) * (result - 3) / 2;
    result = (1 + (5 + 2) * (3 - 2)) / 5;
    result = localArray[0] + localArray[1] * 2;
    result = (5 + 3);
    // 赋值链
    a = b = c = 10;
    // 条件语句
    if (localVar > 0) {
        result = 1;
    } else {
        result = 0;
    }
    // 嵌套条件语句
    if (localVar > 50) {
        if (localChar == 'a') {
            result = 2;
        }
    } else if (localVar < 20) {
        result = 3;
    } else {
        result = 4;
    }
    // 循环语句
    int i = 0;
    while (i < 10) {
        localArray[i] = i * 2;
        localArray(i + 2) * 2] = 100;
        i++;
        if (localVar > 50) {
            if (localChar == 'a') {
                result = 2;
            }
        } else if (localVar < 20) {
            result = 3;
        } else {
            result = 4;
        }
    }
    // 嵌套块
    {//处理不了代码块左右花括号
        int blockVar = 100;
        result = blockVar + localVar;
        {
            int innerVar = 200;
            result = innerVar;
        }
    }
    // 返回语句
    return result;
} //处理不了函数右花括号
// 另一个函数定义
int add(int a, int b) {
    int sum = a + b;
    return sum;
}
// 字符返回函数
char getChar() {
    return 'x';
}
// 指针操作函数
int pointerOps(int *ptr1, int *ptr2) {
    *ptr1 = *ptr2;
    int temp = *ptr1;
    // 指针算术
    ptr1++;
    ptr2--;
    // 比较指针
    if (ptr1 == ptr2) {
        *ptr1 = 0;
    }
    return 0;
}
// 数组操作函数
int arrayOps() {
    int arr[5][10];
    arr[0][0] = 1;
    arr[1][2] = arr[0][0] * 3;
    // 多维数组访问
    int value = arr[1][2];
    return 0;
}
// 混合表达式
int mixedExpressions() {
    int x = 5;
    int y = 10;
    int z;
    // 复杂表达式组合
    z = x++ + ++y * 2;
    // 函数调用在表达式中
    z = add(x,y) * 2;
    z = emptyFunction() + 2;
    // 结构体在表达式中
    struct MyStruct s;
    z = s.member1 + s.arrayMember[0];
    return 0;
}
// 空函数
int emptyFunction() {
    // 空函数体
}
// 只有返回值的函数
int simpleReturn() {
    return 0;
}
// 接受结构体参数的函数
int processStruct (struct MyStruct s) {//函数里面的缺struct也处理不了 //疑难杂症:struct函数右边缺括号也处理不了
    s.member1 = 100;
    s.member2 = 'z';
}
struct MyStruct {
    int arrayMember[10];
    int *alpha;
    int (*point)[2];
};

// 返回结构体的函数
struct MyStruct createStruct() {
    struct MyStruct s;
    s.member1 = 1;
    s.member2 = 'a';
    return s;
}
int main(){
    if(a == 1){
        return 0;
    }
}
